{
  "name": "project with Cloakwall",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install cloakwall",
  "postStartCommand": "nohup cloakwall serve --upstream https://api.openai.com/v1 --upstream-key-env OPENAI_API_KEY --restore --audit-path /tmp/cloakwall-audit.log > /tmp/cloakwall.log 2>&1 &",
  "containerEnv": {
    "OPENAI_BASE_URL": "http://127.0.0.1:8787/v1"
  }
}
