<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cloakwall proxy as a launchd agent (macOS): starts at login, restarts if
  it stops. __HOME__ is replaced with your home folder when you install it:

    pipx install cloakwall
    mkdir -p ~/.cloakwall ~/Library/LaunchAgents
    cp cloakwall-macos.sh ~/.cloakwall/run.sh && chmod 700 ~/.cloakwall/run.sh
    sed "s#__HOME__#$HOME#g" com.cloakwall.proxy.plist > ~/Library/LaunchAgents/com.cloakwall.proxy.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cloakwall.proxy.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cloakwall.proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__HOME__/.cloakwall/run.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/cloakwall/proxy.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/cloakwall/proxy.log</string>
</dict>
</plist>
